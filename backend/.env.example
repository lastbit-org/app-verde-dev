# Dev only. Production must use a strong unique secret — verde-dev-jwt is rejected there.
JWT_SECRET=verde-dev-jwt
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=example
DATABASE_PASSWORD=example
DATABASE_NAME=example
DATABASE_SYNC=true
# Cloud Run + Cloud SQL (unix socket). When set, DATABASE_HOST is ignored.
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

